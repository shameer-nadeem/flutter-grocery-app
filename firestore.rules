rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn();
    }

    match /scans/{scanId} {
      allow read, create, update, delete: if signedIn();
    }
  }
}
